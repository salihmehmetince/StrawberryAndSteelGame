# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Unity generated files
*.pidb.meta
*.pdb.meta
*.mdb.meta
crashlytics-build.properties

# Unity Test Runner generated scenes
InitTestScene*.unity*
/Assets/[Ii]nit[Tt]est[Ss]cene*.unity*

